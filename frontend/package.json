{
  "name": "psychological-report-generator",
  "version": "1.0.0",
  "description": "Offline psychological report generator desktop app",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"ping -n 6 127.0.0.1 >nul && cross-env NODE_ENV=development electron .\"",
    "preelectron:build": "node ../build_exe.js",
    "electron:build": "npm run build && electron-builder",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "clsx": "^2.0.0",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "tailwind-merge": "^2.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.10",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3",
    "vite": "^5.0.7",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.psychreport.app",
    "productName": "PsychReportGen",
    "afterPack": "afterPack.js",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist/report_generator_backend",
        "to": "report_generator_backend"
      }
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "PsychReportGen-${version}-Setup.${ext}",
      "executableName": "PsychReportGen",
      "extraResources": [
        {
          "from": "../ollama/win",
          "to": "ollama",
          "filter": [
            "**/*",
            "!lib/ollama/rocblas/**"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "PsychReportGen-${version}-Portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "PsychReportGen"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "assets/icon.icns",
      "extraResources": [
        {
          "from": "../ollama/mac",
          "to": "ollama"
        }
      ]
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "assets/icon.png",
      "extraResources": [
        {
          "from": "../ollama/linux",
          "to": "ollama"
        }
      ]
    }
  }
}
